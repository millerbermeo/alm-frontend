# Production API origin, baked into the static bundle by `pnpm build`.
# No secrets here — the browser calls this URL directly.
NEXT_PUBLIC_API_URL=https://apis3.millerrivera.com

# Public origin the panel itself is served from (used for absolute URLs in
# metadata/OG). Set this to the real domain when it is known.
# NEXT_PUBLIC_APP_URL=https://panel.example.com
